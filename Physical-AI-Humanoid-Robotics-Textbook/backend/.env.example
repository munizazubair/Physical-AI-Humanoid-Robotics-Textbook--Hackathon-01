# Environment Configuration Template for RAG Chatbot Backend
# Copy this file to .env and fill in the actual values
# NEVER commit .env file to version control

# ============================================================================
# Google Gemini API Configuration
# ============================================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Cohere API Configuration
# ============================================================================
# Get your API key from: https://dashboard.cohere.com/api-keys
# Used for generating embeddings for textbook content
COHERE_API_KEY=your_cohere_api_key_here

# ============================================================================
# Qdrant Vector Database Configuration
# ============================================================================
# Qdrant Cloud URL (e.g., https://your-cluster.qdrant.io)
QDRANT_URL=your_qdrant_url_here

# Qdrant API Key
QDRANT_API_KEY=your_qdrant_api_key_here

# ============================================================================
# Neon PostgreSQL Database Configuration
# ============================================================================
# Neon connection string format:
# postgresql+asyncpg://user:password@host/database?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host/database

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
# For development: http://localhost:3000
# For production: https://yourusername.github.io
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Application Configuration
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Server host and port (for local development)
HOST=0.0.0.0
PORT=8000
